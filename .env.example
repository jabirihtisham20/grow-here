# ========================================================
# Grow Here — Production Environment Variables (.env.example)
# Copy to .env.local for local development, or add in Vercel Project Settings
# ========================================================

# Public Production URL
NEXT_PUBLIC_SITE_URL="https://growhere.online"

# --------------------------------------------------------
# Email & Form Dispatch (Gmail SMTP)
# --------------------------------------------------------
# The Gmail address where all Contact form and Newsletter submissions will be delivered
RECIPIENT_EMAIL="jabirihtisham101@gmail.com"
GMAIL_USER="jabirihtisham101@gmail.com"
# 16-character Google App Password generated at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=""

# --------------------------------------------------------
# Keystatic uses GitHub storage automatically in production. Local development
# uses filesystem storage unless NEXT_PUBLIC_KEYSTATIC_STORAGE is set to github.
# --------------------------------------------------------
# Required by Keystatic's GitHub OAuth integration in Vercel Production
KEYSTATIC_GITHUB_CLIENT_ID=""
KEYSTATIC_GITHUB_CLIENT_SECRET=""
KEYSTATIC_SECRET=""
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=""
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO_OWNER="jabirihtisham20"
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO_NAME="grow-here"

# Optional: set to "github" to use GitHub storage during local development.
NEXT_PUBLIC_KEYSTATIC_STORAGE="local"

# --------------------------------------------------------
# Database-backed admin CMS (the public website remains MDX until cutover is verified)
# Configure DATABASE_URL in your local environment / hosting provider secret manager.
# Do not commit a real PostgreSQL connection string.
# --------------------------------------------------------
DATABASE_URL=""
# Random server-side secret, at least 32 characters; used to hash session tokens and login-rate keys.
SESSION_SECRET=""
ADMIN_URL="http://127.0.0.1:3000/admin"
WEBSITE_URL="http://127.0.0.1:3000"
API_URL="http://127.0.0.1:3000"
